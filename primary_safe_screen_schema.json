{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "br", "info", "reason"],
        "properties": {
          "id": {"type": "integer"},
          "br": {"type": "string", "enum": ["reject", "full", "skip"]},
          "info": {"type": "string", "enum": ["reject", "full", "skip"]},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
